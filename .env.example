# Skin Disease Classification & Stage Identification
# Environment Configuration Template

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_SECRET_KEY=your_secret_key_here

# Admin Login Credentials
SKINAI_USERNAME=admin
